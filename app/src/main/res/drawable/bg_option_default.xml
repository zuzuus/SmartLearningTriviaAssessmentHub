<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="@color/black" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape><solid android:color="@color/panel_highlight" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="@color/black" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape><solid android:color="@color/option_default" /></shape>
            </item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:height="5dp" android:gravity="bottom|fill_horizontal">
                <shape><solid android:color="@color/option_shade" /></shape>
            </item>
        </layer-list>
    </item>
</selector>