<?xml version="1.0" encoding="utf-8"?>
<!-- MAIN ACTIVITY: Title screen + player registration.
     Wrapped in <layout> so Data Binding generates ActivityMainBinding. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cave_base"
        android:fillViewport="true"
        tools:context=".MainActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Pixel cave background, sits right under the hero image -->
            <ImageView
                android:id="@+id/ivCave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/img_cave"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivHero"
                app:layout_constraintWidth_max="480dp" />

            <!-- Hero: pixel wolf howling at the moon -->
            <ImageView
                android:id="@+id/ivHero"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/cd_hero"
                android:scaleType="fitXY"
                android:src="@drawable/img_hero"
                app:layout_constraintDimensionRatio="3:2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/PixelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/title_smart_learning"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivHero" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/PixelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:shadowColor="@color/black"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="0.01"
                android:text="@string/title_trivia_hub"
                android:textColor="@color/bone_white"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <TextView
                android:id="@+id/tvQuest"
                style="@style/RetroBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/title_quest"
                android:textColor="@color/sky_blue"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

            <!-- Registration panel -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panelForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_panel"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvQuest"
                app:layout_constraintWidth_max="420dp">

                <TextView
                    android:id="@+id/tvNewPlayer"
                    style="@style/PixelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_new_player"
                    android:textColor="@color/moon_yellow"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- NAME -->
                <TextView
                    android:id="@+id/tvNameLabel"
                    style="@style/PixelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/etName"
                    android:text="@string/label_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvNewPlayer" />

                <EditText
                    android:id="@+id/etName"
                    style="@style/RetroInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:hint="@string/hint_name"
                    android:inputType="textPersonName|textCapWords"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvNameLabel" />

                <TextView
                    android:id="@+id/tvNameError"
                    style="@style/RetroBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pink_error"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etName" />

                <!-- STUDENT ID -->
                <TextView
                    android:id="@+id/tvIdLabel"
                    style="@style/PixelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/etStudentId"
                    android:text="@string/label_student_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvNameError" />

                <EditText
                    android:id="@+id/etStudentId"
                    style="@style/RetroInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_student_id"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="11"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvIdLabel" />

                <TextView
                    android:id="@+id/tvIdError"
                    style="@style/RetroBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pink_error"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etStudentId" />

                <!-- PROGRAM / GROUP -->
                <TextView
                    android:id="@+id/tvProgramLabel"
                    style="@style/PixelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/etProgram"
                    android:text="@string/label_program"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvIdError" />

                <EditText
                    android:id="@+id/etProgram"
                    style="@style/RetroInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_program"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProgramLabel" />

                <TextView
                    android:id="@+id/tvProgramError"
                    style="@style/RetroBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pink_error"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etProgram" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStart"
                    style="@style/PixelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_start_game"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProgramError" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvFooter"
                style="@style/RetroBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:shadowColor="@color/black"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="0.01"
                android:text="@string/footer_main"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/panelForm" />

            <!-- Keeps room at the bottom for the cave floor art -->
            <Space
                android:layout_width="0dp"
                android:layout_height="96dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFooter" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>